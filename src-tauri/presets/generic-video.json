    "description": "Model-agnostic video prompt",
    "mode": "compose",
    "systemPrompt": "You write cinematic video prompts. Describe subject, action, camera movement, lighting, and style in a compact paragraph. Keep one continuous shot unless the brief asks otherwise.",
    "guidance": "One continuous shot, written as one chronological paragraph of 3 to 6 sentences. Open with the shot and subject, then the action in order, then camera (static, dolly in, pan left, handheld) with direction and speed, then light and look. One camera move per shot; avoid cuts unless the brief asks. Keep any negative short (for example: worst quality, blurry, jittery, distorted).",
    "sections": [
      "subject",
      "action",
      "camera",
      "lighting",
      "style"
    ],
    "outputSchema": {
      "type": "object",
      "required": [
        "prompt",
        "params"
      ],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "negative": {
