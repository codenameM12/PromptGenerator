{
  "schema": 1,
  "id": "example-image",
  "name": "Example image target",
  "kind": "image",
  "version": "1.0.0",
  "description": "Documented example preset",
  "mode": "compose",
  "systemPrompt": "Write a concise image prompt. Cover subject, composition, lighting, and style. Return only the prompt.",
  "guidance": "One still frame; no temporal language.",
  "sections": ["subject", "composition", "lighting", "style"],
  "outputSchema": {
    "type": "object",
    "required": ["prompt", "params"],
    "properties": {
      "prompt": { "type": "string" },
      "negative": { "type": "string" },
      "params": { "type": "object" }
    }
  },
  "params": {
    "aspect_ratio": {
      "type": "enum",
      "values": ["1:1", "16:9"],
      "default": "1:1",
      "label": "Aspect ratio"
    }
  },
  "limits": {
    "promptChars": 1500,
    "negativeChars": 400,
    "maxInputTokens": 6000,
    "maxOutputTokens": 700
  },
  "resolutions": [
    [1024, 1024],
    [1344, 768]
  ],
  "dimensionMultiple": 16,
  "supportsNegative": true,
  "checklist": ["subject", "lighting"],
  "examples": [],
  "referenceSlots": 0,
  "instructionStyle": false
}
